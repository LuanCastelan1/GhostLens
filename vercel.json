{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/index", "destination": "/studio.html" }
  ],
  "functions": {
    "api/wavespeed_proxy.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
