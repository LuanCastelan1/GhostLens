{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/download",
      "dest": "/download.html"
    },
    {
      "src": "/player",
      "dest": "/player.html"
    },
    {
      "src": "/proposta",
      "dest": "/proposta.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
