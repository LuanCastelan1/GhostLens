{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/download", "destination": "/download.html" },
    { "source": "/player", "destination": "/player.html" },
    { "source": "/proposta", "destination": "/proposta.html" },
    { "source": "/obrigado", "destination": "/obrigado.html" },
    { "source": "/studio", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
