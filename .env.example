# ============================================================================
# GhostLens • Variáveis de ambiente
# Copie para .env (local) e/ou configure em Vercel → Settings → Environment
# NUNCA comite valores reais.
# ============================================================================

# ── Supabase (obrigatório para licenças no servidor) ────────────────────────
SUPABASE_URL=https://mbelyevitfksmknlyhgr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Sessão server-side (JWT curto) ──────────────────────────────────────────
# Obrigatório: >= 32 caracteres aleatórios. Sem ele o endpoint retorna 503.
GHOSTLENS_SESSION_SECRET=...
# Validade da sessão em segundos (default 86400 = 24h)
GHOSTLENS_SESSION_TTL=86400

# ── Stripe ──────────────────────────────────────────────────────────────────
# Obrigatório: sem ele o webhook recusa todos os eventos (503).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Asaas ───────────────────────────────────────────────────────────────────
# Obrigatório: token configurado em Asaas → Webhooks.
ASAAS_WEBHOOK_TOKEN=...
# Opcional: usado para buscar o e-mail do cliente (payment.customer).
ASAAS_API_KEY=...
ASAAS_BASE_URL=https://api.asaas.com/v3

# ── E-mail (opcional, mas recomendado) ──────────────────────────────────────
# Sem RESEND_API_KEY a licença é criada, mas o cliente não recebe a chave.
RESEND_API_KEY=re_...
GHOSTLENS_EMAIL_FROM=GhostLens <licencas@ghostlens.cloud>

# ── GhostCreator (opcional) ─────────────────────────────────────────────────
# useapi.net: geração de imagens Nano Banana via Google Flow.
USEAPI_TOKEN=
# E-mail da conta Google conectada na useapi (usado no upload das referências).
USEAPI_ACCOUNT_EMAIL=
# Higgsfield API (vídeo/motion) — integração em configuração.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# RunningHub (workflows ComfyUI privados)
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_INSTANCE_TYPE=plus
# JSON com o registry de workflows. Modelo completo em RUNNINGHUB_WORKFLOWS.example.json
# Aceita defaultSpeedMode (ghostflash/ghostlite), swapInputs e vision.
# RUNNINGHUB_WORKFLOWS={"eros_image_raw":{"name":"Eros-Image RAW 35mm","mode":"image","workflowId":"...","credits":50,"control":"eros","defaultSpeedMode":"ghostflash","inputs":{"prompt":{"nodeId":"6","fieldName":"text"},"image":{"nodeId":"14","fieldName":"image"},"lora":{"nodeId":"21","fieldName":"lora_name"},"lora_weight":{"nodeId":"21","fieldName":"strength_model"},"seed":{"nodeId":"3","fieldName":"seed"}}}}

# ── Agente de Visão Reversa (opcional) ──────────────────────────────────────
# Recebe imagem do Pinterest/upload, extrai composição e monta o prompt no servidor.
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Daemon local (o arquivo .env não é lido automaticamente) ────────────────
# Exporte no shell ou configure no instalador:
# GHOSTLENS_SESSION_URL=https://www.ghostlens.cloud/api/license_session
# GHOSTLENS_SESSION_URLS=https://www.ghostlens.cloud/api/license_session,https://ghostlens.cloud/api/license_session,https://ghostlens.com.br/api/license_session
# GHOSTLENS_ADMIN_TOKEN=            # se vazio, gerado em ~/.ghostphone/admin_token
# GHOSTLENS_HTTP_TIMEOUT=8
# GHOSTLENS_OFFLINE_GRACE_HOURS=24  # sessão vencida ainda funciona offline
# GHOSTLENS_LEGACY_GRACE_HOURS=72   # janela de migração para licenças antigas
# GHOSTLENS_REFRESH_RETRY_SECONDS=300

# Chaves reais ficam em .env.local (ignorado pelo git) ou na Vercel.
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY NUNCA vão para o repositório.