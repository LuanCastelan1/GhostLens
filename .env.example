# ============================================================================
# GhostLens • Variáveis de ambiente
# Copie para .env (local) e/ou configure em Vercel → Settings → Environment
# NUNCA comite valores reais.
# ============================================================================

# ── Supabase (obrigatório para licenças no servidor) ────────────────────────
SUPABASE_URL=https://mbelyevitfksmknlyhgr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Stripe ──────────────────────────────────────────────────────────────────
# Obrigatório: sem ele o webhook recusa todos os eventos (503).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Asaas ───────────────────────────────────────────────────────────────────
# Obrigatório: token configurado em Asaas → Webhooks.
ASAAS_WEBHOOK_TOKEN=...
# Opcional: usado para buscar o e-mail do cliente (payment.customer).
ASAAS_API_KEY=...
ASAAS_BASE_URL=https://api.asaas.com/v3

# ── E-mail (opcional, mas recomendado) ──────────────────────────────────────
# Sem RESEND_API_KEY a licença é criada, mas o cliente não recebe a chave.
RESEND_API_KEY=re_...
GHOSTLENS_EMAIL_FROM=GhostLens <licencas@ghostlens.cloud>

# ── Daemon local (o arquivo .env não é lido automaticamente) ────────────────
# Exporte no shell ou configure no instalador:
# GHOSTLENS_ACTIVATION_URL=https://ghostlens.cloud/api/verify_license
# GHOSTLENS_ACTIVATION_URLS=https://ghostlens.cloud/api/verify_license,https://www.ghostlens.cloud/api/verify_license,https://ghostlens.com.br/api/verify_license
# GHOSTLENS_ADMIN_TOKEN=            # se vazio, gerado em ~/.ghostphone/admin_token
# GHOSTLENS_HTTP_TIMEOUT=8
